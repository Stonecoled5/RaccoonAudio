<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows version in the name is what gives the app Windows' media controls (who's playing what, pause,
         skip). Capturing one program's sound needs Windows 11 (build 20348 or later) at run time; that's checked
         when the app starts, so on an older Windows it says so instead of failing. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RaccoonAudio</AssemblyName>
    <Product>Raccoon Audio</Product>
    <Version>0.1.0</Version>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- The raccoon in headphones: the .exe's icon in Explorer and on the taskbar -->
    <ApplicationIcon>raccoon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same raccoon for the window, the tray and the header, loaded from inside the app -->
    <EmbeddedResource Include="raccoon.ico" LogicalName="raccoon.ico" />
    <EmbeddedResource Include="raccoon.png" LogicalName="raccoon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaccoonAudio.Core\RaccoonAudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
